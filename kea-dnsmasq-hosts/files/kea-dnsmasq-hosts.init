#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 woffko

# After dnsmasq (19) and Kea (25)
START=99
STOP=10

USE_PROCD=1

start_service() {
	local enabled

	config_load kea-dnsmasq-hosts
	config_get_bool enabled main enabled 1
	if [ "$enabled" -eq 0 ]; then
		/usr/sbin/kea-dnsmasq-hosts clear
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/kea-dnsmasq-hosts run
	procd_set_param respawn
	procd_close_instance
}

# The names go with the service: dnsmasq stops answering for them
service_stopped() {
	/usr/sbin/kea-dnsmasq-hosts clear
}

service_triggers() {
	procd_add_reload_trigger "kea-dnsmasq-hosts"
}
