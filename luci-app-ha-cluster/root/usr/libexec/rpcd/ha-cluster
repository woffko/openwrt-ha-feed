# Usage: keepalived_roles <keepalived dump JSON>
# Prints one name:STATE line per instance. Called in a subshell, which
# keeps the jshn state clean.
keepalived_roles() {
	local instances instance inst_name vrrp_state inst_role

	json_load "$1" 2>/dev/null || return 1
	json_select status 2>/dev/null || return 1
	json_get_keys instances

	for instance in $instances; do
		json_select "$instance" || continue
		inst_name=""
		vrrp_state=""
		if json_select data 2>/dev/null; then
			json_get_var inst_name iname
			json_get_var vrrp_state state
			json_select ..
		fi
		json_select ..
		[ -n "$inst_name" ] || continue

		# VRRP_STATE_* values from keepalived's vrrp.h
		case "$vrrp_state" in
			1) inst_role="BACKUP" ;;
			2) inst_role="MASTER" ;;
			3) inst_role="FAULT" ;;
			*) inst_role="UNKNOWN" ;;
		esac

		echo "$inst_name:$inst_role"
	done
}

# Usage: nodes_collect_peer <peer section> (ha-cluster config loaded)
# One line per peer with an address: address|own address|label|vrrp_only
_nodes_peers=""
nodes_collect_peer() {
	local section="$1"
	local address source label vrrp_only

	config_get address "$section" address ""
	[ -n "$address" ] || return 0
	config_get source "$section" source_address ""
	config_get label "$section" name "$section"
	config_get_bool vrrp_only "$section" vrrp_only 0

	_nodes_peers="${_nodes_peers}${address}|$(ha_own_address_for "$address" "$source")|${label}|${vrrp_only}
"
}

# Usage: nodes_role <node id>
# The part suggested for the node in Kea's hot-standby: the first id in
# sort order is the primary. Every node sorts the same ids ($_nodes_sorted)
# and so finds the same parts, without knowing the others' VRRP priority.
nodes_role() {
	local position

	[ -n "$1" ] || return 0
	position=$(printf '%s\n' "$_nodes_sorted" | grep -n -x -F "$1" | head -n 1 | cut -d: -f1)
	case "$position" in
		1) echo "primary" ;;
		2) echo "standby" ;;
		'') ;;
		*) echo "backup" ;;
	esac
}

# Usage: kea_status_get dhcp4|dhcp6
# ha_kea_status_get of ha-cluster.sh, which the switch of the DHCP server
# also asks
kea_status_get() {
	ha_kea_status_get "$1"
}

# Usage: kea_cluster_device <vip or vrrp_instance section>
# (ha-cluster config loaded)
# Adds the device of the section's interface to $_kea_cluster_devices, the
# devices the cluster has an instance or a VIP on.
_kea_cluster_devices=""
kea_cluster_device() {
	local logical device

	config_get logical "$1" interface ""
	[ -n "$logical" ] || return 0
	ha_resolve_device device "$logical" || device="$logical"
	case " $_kea_cluster_devices " in
		*" $device "*) return 0 ;;
	esac
	_kea_cluster_devices="$_kea_cluster_devices $device"
}

# Usage: kea_cluster_socket_error <Kea's socket errors, one per line>
# Prints the first error that names a device of the cluster, and fails when
# none does. Kea calls its sockets "failed" or "retrying" as soon as one of
# them is not open, on whatever interface its config lists (one without an
# address, with "*" every interface of the node), and goes on listening on
# the others. Each error names its interface: "the interface eth0 is down",
# "failed to open socket on interface br-lan, reason: ...".
kea_cluster_socket_error() {
	local errors="$1" device pattern line

	for device in $_kea_cluster_devices; do
		pattern="interface $(printf '%s' "$device" | sed 's/[][\.*^$+?(){}|]/\\&/g')([^A-Za-z0-9._-]|\$)"
		line="$(printf '%s\n' "$errors" | grep -m 1 -E -e "$pattern")" || continue
		printf '%s\n' "$line"
		return 0
	done
	return 1
}

# Usage: kea_probe dhcp4|dhcp6 <daemon name>
# Looks at one Kea daemon and leaves what it found in kea_<daemon>_* (the
# daemon being dhcp4 or dhcp6):
#   enabled        1 when the Kea init script starts it
#   pid            its process, empty when it does not run
#   sockets        ready, retrying or failed, as Kea says: failed and
#                  retrying mean that at least one socket is not open
#   sockets_error  the reason Kea gives for a device of the cluster, else
#                  the first reason it gives
#   ha_mode        hot-standby, load-balancing, passive-backup; empty: no HA
#   ha_state, ha_role, ha_in_touch, ha_partner_state
#   problem        empty, or what keeps this node from being a full member
#                  of the DHCP pair: stopped, not-listening, ha-terminated,
#                  partner-down
# A daemon that is not enabled has no problem, whatever its state. Sockets
# that are not ready are a problem when Kea names a device of the cluster
# ($_kea_cluster_devices) as the reason, or names none at all.
kea_probe() {
	local daemon="$1" name="$2"
	local enabled=0 pid answer problem="" errors cluster_error deaf=0
	local kea_sockets="" kea_sockets_error="" kea_ha_mode="" kea_ha_state="" kea_ha_role=""
	local kea_ha_in_touch="" kea_ha_partner_state=""

	ha_kea_daemon_enabled "$daemon" && enabled=1

	# No -x: BusyBox pgrep matches the path the daemon was started with,
	# so an exact match on the bare name finds nothing
	pid=$(pgrep -o "$name" 2>/dev/null)

	if [ -n "$pid" ]; then
		answer="$(kea_status_get "$daemon")"
		[ -n "$answer" ] && eval "$(printf '%s' "$answer" | jsonfilter \
			-e 'kea_sockets=@.arguments.sockets.status' \
			-e 'kea_ha_mode=@.arguments["high-availability"][0]["ha-mode"]' \
			-e 'kea_ha_state=@.arguments["high-availability"][0]["ha-servers"].local.state' \
			-e 'kea_ha_role=@.arguments["high-availability"][0]["ha-servers"].local.role' \
			-e 'kea_ha_in_touch=@.arguments["high-availability"][0]["ha-servers"].remote["in-touch"]' \
			-e 'kea_ha_partner_state=@.arguments["high-availability"][0]["ha-servers"].remote["last-state"]' \
			2>/dev/null)"
	fi

	if [ -n "$kea_sockets" ] && [ "$kea_sockets" != "ready" ]; then
		errors="$(printf '%s' "$answer" | jsonfilter -e '@.arguments.sockets.errors[*]' 2>/dev/null)"
		if [ -z "$errors" ]; then
			deaf=1
		elif cluster_error="$(kea_cluster_socket_error "$errors")"; then
			deaf=1
			kea_sockets_error="$cluster_error"
		else
			kea_sockets_error="$(printf '%s\n' "$errors" | head -n 1)"
		fi
	fi

	if [ "$enabled" -eq 1 ]; then
		if [ -z "$pid" ]; then
			problem="stopped"
		elif [ "$deaf" -eq 1 ]; then
			problem="not-listening"
		elif [ "$kea_ha_state" = "terminated" ]; then
			problem="ha-terminated"
		elif [ "$kea_ha_state" = "partner-down" ]; then
			problem="partner-down"
		fi
	fi

	eval "kea_${daemon}_enabled=\$enabled"
	eval "kea_${daemon}_pid=\$pid"
	eval "kea_${daemon}_sockets=\$kea_sockets"
	eval "kea_${daemon}_sockets_error=\$kea_sockets_error"
	eval "kea_${daemon}_ha_mode=\$kea_ha_mode"
	eval "kea_${daemon}_ha_state=\$kea_ha_state"
	eval "kea_${daemon}_ha_role=\$kea_ha_role"
	eval "kea_${daemon}_ha_in_touch=\$kea_ha_in_touch"
	eval "kea_${daemon}_ha_partner_state=\$kea_ha_partner_state"
	eval "kea_${daemon}_problem=\$problem"
}

# Usage: kea_service <daemon: dhcp4|dhcp6> <daemon name> <binary>
# Adds the daemon to the "services" object from what kea_probe found.
# ha-cluster does not run Kea, so the daemon is never required: the entry
# says whether it is there, runs, listens, and how its own high availability
# is doing.
kea_service() {
	local daemon="$1" name="$2" binary="$3"
	local pid start_time uptime_jiffies uptime_sec=0
	local enabled sockets sockets_error ha_mode ha_state ha_role ha_in_touch ha_partner_state problem

	eval "enabled=\$kea_${daemon}_enabled"
	eval "pid=\$kea_${daemon}_pid"
	eval "sockets=\$kea_${daemon}_sockets"
	eval "sockets_error=\$kea_${daemon}_sockets_error"
	eval "ha_mode=\$kea_${daemon}_ha_mode"
	eval "ha_state=\$kea_${daemon}_ha_state"
	eval "ha_role=\$kea_${daemon}_ha_role"
	eval "ha_in_touch=\$kea_${daemon}_ha_in_touch"
	eval "ha_partner_state=\$kea_${daemon}_ha_partner_state"
	eval "problem=\$kea_${daemon}_problem"

	json_add_object "$name"
	json_add_boolean required 0
	json_add_boolean enabled "${enabled:-0}"
	if [ -x "$binary" ]; then
		json_add_boolean installed 1
	else
		json_add_boolean installed 0
	fi

	if [ -n "$pid" ]; then
		start_time=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null)
		if [ -n "$start_time" ]; then
			uptime_jiffies=$(awk '{print $1 * 100}' /proc/uptime 2>/dev/null)
			uptime_sec=$(awk "BEGIN{print int(($uptime_jiffies - $start_time) / 100)}")
		fi
		json_add_boolean running 1
		json_add_int pid "$pid"
		json_add_int uptime "$uptime_sec"
	else
		json_add_boolean running 0
		json_add_int pid 0
		json_add_int uptime 0
	fi

	[ -n "$sockets" ] && json_add_string sockets "$sockets"
	[ -n "$sockets_error" ] && json_add_string sockets_error "$sockets_error"
	if [ -n "$ha_mode" ]; then
		json_add_object ha
		json_add_string mode "$ha_mode"
		json_add_string state "$ha_state"
		json_add_string role "$ha_role"
		[ -n "$ha_in_touch" ] && json_add_boolean partner_in_touch "$ha_in_touch"
		[ -n "$ha_partner_state" ] && json_add_string partner_state "$ha_partner_state"
		json_close_object
	fi
	[ -n "$problem" ] && json_add_string problem "$problem"
	json_close_object
}

# Usage: kea_import_left <file with what the import printed>
# Adds kea_import: the static leases of dnsmasq the last import did not take
# into Kea (those that need luci-app-kea's Import page), with their status
kea_import_left() {
	local out count i name identifier address status

	out="$(cat "$1")"
	count=$(printf '%s' "$out" | jsonfilter -e '@.left[*].key' 2>/dev/null | wc -l)
	json_add_object kea_import
	json_add_int left "$count"
	json_add_array entries
	i=0
	while [ "$i" -lt "$count" ] && [ "$i" -lt 50 ]; do
		name="" identifier="" address="" status=""
		eval "$(printf '%s' "$out" | jsonfilter \
			-e "name=@.left[$i].name" -e "identifier=@.left[$i].identifier" \
			-e "address=@.left[$i].address" -e "status=@.left[$i].status" 2>/dev/null)"
		json_add_object
		json_add_string name "$name"
		json_add_string identifier "$identifier"
		json_add_string address "$address"
		json_add_string status "$status"
		json_close_object
		i=$((i + 1))
	done
	json_close_array
	json_close_object
}

case "$1" in
	list)
		json_init
		json_add_object "generate_key"
		json_close_object
		json_add_object "status"
		json_close_object
		json_add_object "nodes"
		json_close_object
		json_add_object "apply"
		json_close_object
		json_dump
		;;
	call)
		case "$2" in
			generate_key)
				key=$(hexdump -n 32 -v -e '1/1 "%02x"' /dev/urandom 2>/dev/null)

				if [ -z "$key" ] || [ ${#key} -ne 64 ]; then
					json_init
					json_add_boolean success 0
					json_add_string error "Failed to generate key"
					json_dump
					exit 1
				fi

				json_init
				json_add_boolean success 1
				json_add_string key "$key"
				json_dump
				;;

			status)
				node_role="UNKNOWN"
				cluster_state="STOPPED"
				services_ok=1
				peers_online=0
				peers_total=0
				instance_roles=""
				owsync_required=0
				lease_sync_required=0
				owsync_wanted=0
				lease_sync_wanted=0

				ha_enabled=$(get_bool "$(uci -q get ha-cluster.config.enabled)" 0)

				# The server the node runs, and what the config asks for
				config_load ha-cluster
				dhcp_backend=$(ha_dhcp_backend)
				dhcp_backend_mode=$(ha_dhcp_backend_mode)
				dhcp_backend_problem=""
				[ -r "$HA_DHCP_BACKEND_PROBLEM" ] && dhcp_backend_problem=$(head -n 1 "$HA_DHCP_BACKEND_PROBLEM")
				[ "$ha_enabled" = "1" ] && [ -z "$dhcp_backend_problem" ] &&
					dhcp_backend_problem=$(ha_dhcp_pools_mismatch)

				if [ "$ha_enabled" != "1" ]; then
					cluster_state="STOPPED"
				else
					keepalived_data=$(ubus call keepalived dump 2>/dev/null)

					if [ -n "$keepalived_data" ]; then
						instance_roles=$(keepalived_roles "$keepalived_data")

						# The dump reads keepalived's stats file without waiting for
						# it to be written and now and then finds none: retry once
						if [ -z "$instance_roles" ]; then
							keepalived_data=$(ubus call keepalived dump 2>/dev/null)
							instance_roles=$(keepalived_roles "$keepalived_data")
						fi

						has_fault=0
						has_master=0
						has_backup=0
						instance_count=0
						for entry in $instance_roles; do
							role_val="${entry##*:}"
							case "$role_val" in
								FAULT) has_fault=1 ;;
								MASTER) has_master=1 ;;
								BACKUP) has_backup=1 ;;
							esac
							instance_count=$((instance_count + 1))
						done

						if [ "$has_fault" -eq 1 ]; then
							node_role="FAULT"
						elif [ "$has_master" -eq 1 ] && [ "$has_backup" -eq 0 ]; then
							node_role="MASTER"
						elif [ "$has_backup" -eq 1 ] && [ "$has_master" -eq 0 ]; then
							node_role="BACKUP"
						elif [ "$has_master" -eq 1 ] && [ "$has_backup" -eq 1 ]; then
							node_role="MIXED"
						elif [ "$instance_count" -eq 0 ]; then
							node_role="UNKNOWN"
						fi
					else
						node_role="FAULT"
						services_ok=0
					fi

					# The backend writes a daemon config only when procd has to
					# run that daemon
					[ -f "$OWSYNC_CONF" ] && owsync_required=1
					[ -f "$LEASE_SYNC_CONF" ] && lease_sync_required=1

					# Would run if installed
					config_load ha-cluster
					ha_owsync_wanted && owsync_wanted=1
					ha_lease_sync_wanted && lease_sync_wanted=1

					if ! pgrep "keepalived" >/dev/null 2>&1; then
						services_ok=0
					fi
					if [ "$owsync_required" -eq 1 ] && ! pgrep "owsync" >/dev/null 2>&1; then
						services_ok=0
					fi
					if [ "$lease_sync_required" -eq 1 ] && ! pgrep "lease-sync" >/dev/null 2>&1; then
						services_ok=0
					fi
				fi

				config_last_sync=0
				lease_last_sync=0

				# OpenWrt's BusyBox has no stat(1)
				owsync_db=""
				[ -f "$OWSYNC_CONF" ] && owsync_db=$(sed -n 's/^database=//p' "$OWSYNC_CONF" | tail -n 1)
				if [ -n "$owsync_db" ] && [ -f "$owsync_db" ]; then
					config_last_sync=$(date -r "$owsync_db" +%s 2>/dev/null || echo 0)
				fi

				# The lease file of dnsmasq says nothing about the leases of Kea
				leasefile=$(uci -q get dhcp.@dnsmasq[0].leasefile)
				leasefile=${leasefile:-/tmp/dhcp.leases}
				if [ "$dhcp_backend" != "kea" ] && [ -f "$leasefile" ]; then
					lease_last_sync=$(date -r "$leasefile" +%s 2>/dev/null || echo 0)
				fi

				json_init
				json_add_string role "$node_role"

				json_add_object instances
				for entry in $instance_roles; do
					inst_name="${entry%%:*}"
					inst_role="${entry##*:}"
					case "$inst_role" in
						MASTER|BACKUP|FAULT|UNKNOWN) ;;
						*) inst_role="UNKNOWN" ;;
					esac
					json_add_string "$inst_name" "$inst_role"
				done
				json_close_object

				json_add_array peers
				for peer_section in $(uci show ha-cluster 2>/dev/null | grep "=peer$" | cut -d. -f2 | cut -d= -f1); do
					peer_name=$(uci -q get "ha-cluster.$peer_section.name")
					peer_addr=$(uci -q get "ha-cluster.$peer_section.address")
					if [ -n "$peer_addr" ]; then
						peers_total=$((peers_total + 1))
						peer_online=0
						case "$peer_addr" in
							*:*) ping_cmd="ping6" ;;
							*) ping_cmd="ping" ;;
						esac
						if $ping_cmd -c 1 -W 1 -- "$peer_addr" >/dev/null 2>&1; then
							peer_online=1
							peers_online=$((peers_online + 1))
							last_seen="Just now"
						else
							last_seen="Unreachable"
						fi

						json_add_object
						json_add_string name "${peer_name:-$peer_section}"
						json_add_string address "$peer_addr"
						json_add_boolean online "$peer_online"
						json_add_boolean vrrp_only "$(get_bool "$(uci -q get "ha-cluster.$peer_section.vrrp_only")" 0)"
						json_add_string last_seen "$last_seen"
						json_close_object
					fi
				done
				json_close_array

				# Kea is not run by ha-cluster and so is never what makes the
				# cluster faulty; but a cluster whose DHCP server is down, deaf
				# or alone on this node is not healthy either
				kea_problem=0
				if [ "$dhcp_backend" = "kea" ]; then
					config_load ha-cluster
					_kea_cluster_devices=""
					config_foreach kea_cluster_device vrrp_instance
					config_foreach kea_cluster_device vip
					kea_probe dhcp4 kea-dhcp4
					kea_probe dhcp6 kea-dhcp6
					[ -n "$kea_dhcp4_problem$kea_dhcp6_problem" ] && kea_problem=1
				fi

				# A config of the releases before 2.0 that the service has not
				# migrated yet, or could not: no file or lease sync, whatever
				# the daemons say
				earlier_model=$(ha_config_earlier_model)

				if [ "$ha_enabled" != "1" ]; then
					cluster_state="STOPPED"
				elif [ "$services_ok" -eq 0 ]; then
					cluster_state="FAULTY"
				elif [ "$peers_online" -lt "$peers_total" ] && [ "$peers_total" -gt 0 ]; then
					cluster_state="DEGRADED"
				elif [ "$kea_problem" -eq 1 ]; then
					cluster_state="DEGRADED"
				elif [ -n "$earlier_model" ]; then
					cluster_state="DEGRADED"
				elif [ -n "$dhcp_backend_problem" ]; then
					cluster_state="DEGRADED"
				elif [ "$services_ok" -eq 1 ]; then
					cluster_state="HEALTHY"
				fi
				json_add_string state "$cluster_state"
				json_add_string dhcp_backend "$dhcp_backend"
				json_add_string dhcp_backend_mode "$dhcp_backend_mode"
				[ -n "$dhcp_backend_problem" ] && json_add_string dhcp_backend_problem "$dhcp_backend_problem"
				# What the last import of dnsmasq's static leases into Kea left
				if [ "$dhcp_backend" = "kea" ] && [ -r "$HA_KEA_IMPORT_RESULT" ]; then
					kea_import_left "$HA_KEA_IMPORT_RESULT"
				fi
				if [ -n "$earlier_model" ]; then
					json_add_array earlier_model
					oldifs="$IFS"
					IFS='
'
					for entry in $earlier_model; do
						json_add_string "" "$entry"
					done
					IFS="$oldifs"
					json_close_array
				fi


				json_add_object services

				json_add_object "keepalived"
				json_add_boolean required 1
				svc_pid=$(pgrep -o "keepalived" 2>/dev/null)
				if [ -n "$svc_pid" ]; then
					json_add_boolean running 1
					json_add_int pid "$svc_pid"
					start_time=$(awk '{print $22}' /proc/$svc_pid/stat 2>/dev/null)
					if [ -n "$start_time" ]; then
						uptime_jiffies=$(awk '{print $1 * 100}' /proc/uptime 2>/dev/null)
						uptime_sec=$(awk "BEGIN{print int(($uptime_jiffies - $start_time) / 100)}")
						json_add_int uptime "$uptime_sec"
					else
						json_add_int uptime 0
					fi
				else
					json_add_boolean running 0
					json_add_int pid 0
					json_add_int uptime 0
				fi
				json_close_object

				json_add_object "owsync"
				if [ "$owsync_required" -eq 1 ]; then
					json_add_boolean required 1
				else
					json_add_boolean required 0
				fi
				json_add_boolean wanted "$owsync_wanted"
				svc_pid=$(pgrep -o "owsync" 2>/dev/null)
				if [ -n "$svc_pid" ]; then
					json_add_boolean running 1
					json_add_int pid "$svc_pid"
					start_time=$(awk '{print $22}' /proc/$svc_pid/stat 2>/dev/null)
					if [ -n "$start_time" ]; then
						uptime_jiffies=$(awk '{print $1 * 100}' /proc/uptime 2>/dev/null)
						uptime_sec=$(awk "BEGIN{print int(($uptime_jiffies - $start_time) / 100)}")
						json_add_int uptime "$uptime_sec"
					else
						json_add_int uptime 0
					fi
				else
					json_add_boolean running 0
					json_add_int pid 0
					json_add_int uptime 0
				fi
				json_close_object

				json_add_object "lease-sync"
				if [ "$lease_sync_required" -eq 1 ]; then
					json_add_boolean required 1
				else
					json_add_boolean required 0
				fi
				json_add_boolean wanted "$lease_sync_wanted"
				svc_pid=$(pgrep -o "lease-sync" 2>/dev/null)
				if [ -n "$svc_pid" ]; then
					json_add_boolean running 1
					json_add_int pid "$svc_pid"
					start_time=$(awk '{print $22}' /proc/$svc_pid/stat 2>/dev/null)
					if [ -n "$start_time" ]; then
						uptime_jiffies=$(awk '{print $1 * 100}' /proc/uptime 2>/dev/null)
						uptime_sec=$(awk "BEGIN{print int(($uptime_jiffies - $start_time) / 100)}")
						json_add_int uptime "$uptime_sec"
					else
						json_add_int uptime 0
					fi
				else
					json_add_boolean running 0
					json_add_int pid 0
					json_add_int uptime 0
				fi
				json_close_object

				if [ "$dhcp_backend" = "kea" ]; then
					kea_service dhcp4 kea-dhcp4 "$KEA_DHCP4_BIN"
					kea_service dhcp6 kea-dhcp6 "$KEA_DHCP6_BIN"
				fi

				json_close_object

				json_add_object sync
				json_add_int config_last_sync "$config_last_sync"
				json_add_int lease_last_sync "$lease_last_sync"
				json_close_object

				json_dump
				;;

			# The nodes of the cluster as a DHCP server pair needs them: a
			# name for each that is the same on every node, the address its
			# partner reaches it at, and who would be Kea's primary. For a
			# tool that sets up Kea's high availability; nothing here is
			# written anywhere.
			nodes)
				config_load ha-cluster
				config_get node_priority config node_priority "100"
				dhcp_backend=$(ha_dhcp_backend)

				_nodes_peers=""
				config_foreach nodes_collect_peer peer

				# This node's address towards the first peer it syncs with,
				# else towards the first peer
				own_address=$(printf '%s' "$_nodes_peers" | awk -F'|' '$4 == 0 && $2 != "" { print $2; exit }')
				[ -n "$own_address" ] ||
					own_address=$(printf '%s' "$_nodes_peers" | awk -F'|' '$2 != "" { print $2; exit }')

				own_id=""
				_nodes_sorted=""
				if [ -n "$own_address" ]; then
					own_id=$(ha_node_id "$own_address")
					_nodes_sorted=$( {
						echo "$own_id"
						printf '%s' "$_nodes_peers" | awk -F'|' '$4 == 0 { print $1 }' |
							while read -r peer_address; do ha_node_id "$peer_address"; done
					} | LC_ALL=C sort -u)
				fi

				json_init
				json_add_string dhcp_backend "$dhcp_backend"
				json_add_object node
				json_add_string name "$own_id"
				json_add_string label "$(cat /proc/sys/kernel/hostname)"
				json_add_string address "$own_address"
				json_add_int priority "$node_priority"
				role=$(nodes_role "$own_id")
				[ -n "$role" ] && json_add_string kea_role "$role"
				json_close_object

				json_add_array peers
				oldifs="$IFS"
				IFS='
'
				for line in $_nodes_peers; do
					IFS='|' read -r peer_address own_for_peer peer_label peer_vrrp_only <<EOF
$line
EOF
					peer_id=$(ha_node_id "$peer_address")
					json_add_object
					json_add_string name "$peer_id"
					json_add_string label "$peer_label"
					json_add_string address "$peer_address"
					json_add_boolean vrrp_only "$peer_vrrp_only"
					# A VRRP-only peer is not among the sorted names
					role=$(nodes_role "$peer_id")
					[ -n "$role" ] && json_add_string kea_role "$role"
					json_close_object
				done
				IFS="$oldifs"
				json_close_array
				json_dump
				;;

			apply)
				if /etc/init.d/ha-cluster reload >/dev/null 2>&1; then
					json_init
					json_add_boolean success 1
					json_dump
				else
					json_init
					json_add_boolean success 0
					json_add_string error "Failed to reload service"
					json_dump
					exit 1
				fi
				;;

			*)
				json_init
				json_add_boolean success 0
				json_add_string error "Unknown method: $2"
				json_dump
				exit 1
				;;
		esac
		;;
esac
