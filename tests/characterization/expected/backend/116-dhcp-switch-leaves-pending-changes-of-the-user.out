== uci
package ha-cluster

config global 'config'
	option enabled '1'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'
	option encryption_key '7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	option priority '200'
	option nopreempt '0'
	option advert_int '1'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'

config service 'dhcp'
	option enabled '1'
	option sync_leases '1'
	list config_files 'dhcp'

config service 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'

package dhcp

config dnsmasq
	option domain 'lan'
	option leasefile '/tmp/dhcp.leases'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option force '1'

== uci after migration
package ha-cluster

config global 'config'
	option enabled '1'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'
	option encryption_key '7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e'
	option lease_sync '1'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	option priority '200'
	option nopreempt '0'
	option advert_int '1'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'

config sync_group 'dhcp'
	option enabled '1'
	list config_files 'dhcp'

config sync_group 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'

== start_service
instance [keepalived]
	set [command] [/usr/sbin/keepalived]
	append [command] [-n]
	append [command] [-f] [/var/run/ha-cluster/keepalived.conf]
	set [file] [/var/run/ha-cluster/keepalived.conf]
	set [reload_signal] [HUP]
	set [respawn]
	set [stdout] [1]
	set [stderr] [1]
end
instance [owsync]
	set [command] [/usr/bin/owsync] [daemon]
	append [command] [-c] [/var/run/ha-cluster/owsync.conf]
	set [file] [/var/run/ha-cluster/owsync.conf]
	set [respawn]
	set [stdout] [1]
	set [stderr] [1]
end
rc=0
== service_triggers
reload_trigger [ha-cluster]
raw_trigger [kea.service] [1000] [/etc/init.d/ha-cluster] [kea_changed]
config_trigger [config.change] [dhcp] [/etc/init.d/ha-cluster] [dhcp_changed]
== log
ha-cluster|daemon.info|Starting HA cluster
ha-cluster|daemon.info|Switching the DHCP server of the cluster interfaces from dnsmasq to Kea (dhcp_backend 'auto')
ha-cluster|daemon.info|dnsmasq's static leases imported into Kea: 1 new reservations
ha-cluster|daemon.info|Kea is the DHCP server of the cluster interfaces: dnsmasq's DHCPv4 switched off in lan
ha-cluster|daemon.info|Applying HA cluster configuration
ha-cluster|daemon.info|lease_sync is not used with Kea as the DHCP server: Kea replicates its leases itself
ha-cluster|daemon.warning|kea-dhcp4 listens on 'br-lan' without an address while 'lan' (br-lan) carries a VIP as well: Kea opens a socket for each address there and takes each request of a client, and answers it, once per address. Name 'br-lan/192.168.50.10' in its interfaces-config instead
ha-cluster|daemon.info|Taking over service management from standalone init scripts
ha-cluster|daemon.info|Disabled standalone service: keepalived
ha-cluster|daemon.info|Disabled standalone service: owsync
lease-sync|daemon.info|Stopping lease-sync daemon
ha-cluster|daemon.info|Disabled standalone service: lease-sync
ha-cluster|daemon.info|Generating keepalived configuration for node: ha-char
ha-cluster|daemon.info|Keepalived configuration generated at /var/run/ha-cluster/keepalived.conf
ha-cluster|daemon.info|Generating owsync configuration
ha-cluster|daemon.info|owsync configuration generated at /var/run/ha-cluster/owsync.conf
ha-cluster|daemon.info|HA cluster configuration applied successfully
ha-cluster|daemon.warning|Firewall rules of the cluster not written: this node's own address towards 172.30.0.11 is not known. Set bind_address, or source_address of the peer, or reload ha-cluster once the interface is up
ha-cluster|daemon.info|Starting keepalived daemon
ha-cluster|daemon.info|Starting owsync daemon
== ls /var/run/ha-cluster
dhcp-backend.lock
firewall.lock
kea-import.json
keepalived.conf
owsync.conf
uci-dhcp
uci-firewall
== /var/run/ha-cluster/keepalived.conf
! Keepalived configuration - Generated by ha-cluster
! DO NOT EDIT - This file is auto-generated when HA cluster is enabled
! Edit /etc/config/ha-cluster instead

global_defs {
    router_id ha-char
    dynamic_interfaces
    script_user root
    enable_script_security
    max_auto_priority 0
}

vrrp_instance main {
    state BACKUP
    interface br-lan
    virtual_router_id 51
    priority 200
    advert_int 1
    virtual_ipaddress {
        192.168.50.254/24 dev br-lan
    }

    # Notify scripts for state changes
    notify_master "/bin/busybox env -i ACTION=MASTER TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
    notify_backup "/bin/busybox env -i ACTION=BACKUP TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
    notify_fault "/bin/busybox env -i ACTION=FAULT TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
}

== /var/run/ha-cluster/owsync.conf
# Auto-generated by ha-cluster
# DO NOT EDIT - changes will be overwritten when HA cluster restarts
# Edit /etc/config/ha-cluster instead

# Network settings
bind_host=::
port=4321

# Paths (OpenWrt-specific)
sync_dir=/etc/config
database=/etc/owsync/owsync.db

# Daemon settings
poll_interval=30
log_level=2
# Applies what came from a peer (owsync 1.3.0-r6 and later; an older one
# warns about the key and goes on)
on_change=/usr/lib/ha-cluster/owsync-changed

# Security: PSK encryption enabled
encryption_key=7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e

# Peers
peer=172.30.0.11

# Include patterns (sync these files)
include=dhcp

# Exclude patterns (never sync these)
exclude=network
exclude=system
exclude=owsync
exclude=ha-cluster
== /var/run/ha-cluster/lease-sync.conf
(absent)
