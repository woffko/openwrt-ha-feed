== uci
package ha-cluster

config global 'config'
	option enabled '1'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'
	option encryption_key '7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	option priority '200'
	option nopreempt '0'
	option advert_int '1'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'

config service 'dhcp'
	option enabled '1'
	option sync_leases '1'
	list config_files 'dhcp'

config service 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'

config uplink 'u1'

config uplink 'u2'
	option interface 'wan3'
	option mode 'master'
	option vrrp_instance 'main'

config uplink 'u3'
	option interface 'wan'
	option mode 'sometimes'
	option vrrp_instance 'main'

config uplink 'u4'
	option interface 'wanb'
	option mode 'master'

config uplink 'u5'
	option interface 'wanb'
	option mode 'always'
	option vrrp_instance 'nosuch'

config uplink 'u6'
	option interface 'wan'
	option mode 'master'
	option vrrp_instance 'main'
	option retry '1'
	option up_delay 'x'
	option grace '90000'

package dhcp

config dnsmasq
	option domain 'lan'
	option leasefile '/tmp/dhcp.leases'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option force '1'

== uci after migration
package ha-cluster

config global 'config'
	option enabled '1'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'
	option encryption_key '7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e'
	option lease_sync '1'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	option priority '200'
	option nopreempt '0'
	option advert_int '1'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'

config sync_group 'dhcp'
	option enabled '1'
	list config_files 'dhcp'

config sync_group 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'

config uplink 'u1'

config uplink 'u2'
	option interface 'wan3'
	option mode 'master'
	option vrrp_instance 'main'

config uplink 'u3'
	option interface 'wan'
	option mode 'sometimes'
	option vrrp_instance 'main'

config uplink 'u4'
	option interface 'wanb'
	option mode 'master'

config uplink 'u5'
	option interface 'wanb'
	option mode 'always'
	option vrrp_instance 'nosuch'

config uplink 'u6'
	option interface 'wan'
	option mode 'master'
	option vrrp_instance 'main'
	option retry '1'
	option up_delay 'x'
	option grace '90000'

== start_service
rc=1
== service_triggers
reload_trigger [ha-cluster]
raw_trigger [kea.service] [1000] [/etc/init.d/ha-cluster] [kea_changed]
config_trigger [config.change] [dhcp] [/etc/init.d/ha-cluster] [dhcp_changed]
config_trigger [config.change] [firewall] [/etc/init.d/ha-cluster] [firewall_changed]
== log
ha-cluster|daemon.info|Starting HA cluster
ha-cluster|daemon.info|Applying HA cluster configuration
ha-cluster|daemon.err|uplink u1: interface is required
ha-cluster|daemon.err|uplink u1: vrrp_instance is required in mode 'master'
ha-cluster|daemon.err|uplink u2: 'wan3' is not an interface of /etc/config/network
ha-cluster|daemon.err|uplink u3: mode must be 'master', 'always' or 'unmanaged' (got: sometimes)
ha-cluster|daemon.err|uplink u4: vrrp_instance is required in mode 'master'
ha-cluster|daemon.err|uplink u5: interface 'wanb' has another uplink section
ha-cluster|daemon.err|uplink u5: vrrp_instance 'nosuch' does not exist
ha-cluster|daemon.err|uplink u6: interface 'wan' has another uplink section
ha-cluster|daemon.err|uplink u6: up_delay must be 0-3600 (got: x)
ha-cluster|daemon.err|uplink u6: grace must be 0-86400 (got: 90000)
ha-cluster|daemon.err|uplink u6: retry must be 5-3600 (got: 1)
ha-cluster|daemon.err|Configuration validation failed
ha-cluster|daemon.err|Failed to apply configuration
== ls /var/run/ha-cluster
dhcp-backend.lock
uci-dhcp
== /var/run/ha-cluster/keepalived.conf
(absent)
== /var/run/ha-cluster/owsync.conf
(absent)
== /var/run/ha-cluster/lease-sync.conf
(absent)
== ls /tmp/dnsmasq.cfg01411c.d
(absent)
== /tmp/dnsmasq.cfg01411c.d/ha-cluster.conf
(absent)
== ls /etc/ha-cluster
dhcp-backend
firewall-dhcp-server
== /etc/ha-cluster/service_states
(absent)
== firewall rules of the cluster
(none)
== rc.d
K01keepalived
K10lease-sync
K10owsync
K91ha-cluster
S25ha-cluster
S70keepalived
S99lease-sync
S99owsync
