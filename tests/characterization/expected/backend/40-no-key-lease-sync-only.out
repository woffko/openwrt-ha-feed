== uci
package ha-cluster

config global 'config'
	option enabled '1'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	option priority '200'
	option nopreempt '0'
	option advert_int '1'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'

config service 'dhcp'
	option enabled '1'
	option sync_leases '1'
	list config_files 'dhcp'

config service 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'

package dhcp

config dnsmasq
	option domain 'lan'
	option leasefile '/tmp/dhcp.leases'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option force '1'

== uci after migration
package ha-cluster

config global 'config'
	option enabled '1'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'
	option lease_sync '1'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	option priority '200'
	option nopreempt '0'
	option advert_int '1'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'

config sync_group 'dhcp'
	option enabled '1'
	list config_files 'dhcp'

config sync_group 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'

== start_service
rc=1
== service_triggers
reload_trigger [ha-cluster]
== log
ha-cluster|daemon.info|Starting HA cluster
ha-cluster|daemon.info|Applying HA cluster configuration
ha-cluster|daemon.err|sync_encryption is enabled but encryption_key is empty
ha-cluster|daemon.err|Set the same key on all nodes, generated in LuCI or with: hexdump -n 32 -v -e '1/1 "%02x"' /dev/urandom; or set sync_encryption '0'
ha-cluster|daemon.err|Configuration validation failed
ha-cluster|daemon.err|Failed to apply configuration
== ls /var/run/ha-cluster
== /var/run/ha-cluster/keepalived.conf
(absent)
== /var/run/ha-cluster/owsync.conf
(absent)
== /var/run/ha-cluster/lease-sync.conf
(absent)
== ls /tmp/dnsmasq.cfg01411c.d
(absent)
== /tmp/dnsmasq.cfg01411c.d/ha-cluster.conf
(absent)
== ls /etc/ha-cluster
(absent)
== /etc/ha-cluster/service_states
(absent)
== firewall rules of the cluster
(none)
== rc.d
K01keepalived
K10lease-sync
K10owsync
K91ha-cluster
S25ha-cluster
S70keepalived
S99lease-sync
S99owsync
