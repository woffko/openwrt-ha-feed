ha-cluster|daemon.info|Starting owsync daemon
== ls /var/run/ha-cluster
dhcp-backend.lock
firewall.lock
keepalived.conf
owsync.conf
uci-dhcp
uci-firewall
== /var/run/ha-cluster/keepalived.conf
! Keepalived configuration - Generated by ha-cluster
! DO NOT EDIT - This file is auto-generated when HA cluster is enabled
! Edit /etc/config/ha-cluster instead

global_defs {
    router_id ha-char
    dynamic_interfaces
    script_user root
    enable_script_security
    max_auto_priority 0
}

vrrp_instance main {
    state BACKUP
    interface lan
    virtual_router_id 51
    priority 200
    advert_int 1
    virtual_ipaddress {
        192.168.50.254/24 dev lan
    }

    # Notify scripts for state changes
    notify_master "/bin/busybox env -i ACTION=MASTER TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
    notify_backup "/bin/busybox env -i ACTION=BACKUP TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
    notify_fault "/bin/busybox env -i ACTION=FAULT TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
}

== /var/run/ha-cluster/owsync.conf
# Auto-generated by ha-cluster
# DO NOT EDIT - changes will be overwritten when HA cluster restarts
# Edit /etc/config/ha-cluster instead

# Network settings
bind_host=172.30.0.10
port=4321

# Paths (OpenWrt-specific)
sync_dir=/etc/config
database=/etc/owsync/owsync.db

# Daemon settings
poll_interval=30
log_level=2
# Applies what came from a peer (owsync 1.3.0-r6 and later; an older one
# warns about the key and goes on)
on_change=/usr/lib/ha-cluster/owsync-changed

# Security: PSK encryption enabled
encryption_key=7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e

# Peers
peer=172.30.0.11

# Include patterns (sync these files)
include=dhcp

# Exclude patterns (never sync these)
exclude=network
exclude=system
exclude=owsync
exclude=ha-cluster
== /var/run/ha-cluster/lease-sync.conf
(absent)
== ls /tmp/dnsmasq.cfg01411c.d
(absent)
== /tmp/dnsmasq.cfg01411c.d/ha-cluster.conf
(absent)
== ls /etc/ha-cluster
dhcp-backend
firewall-dhcp-server
service_states
== /etc/ha-cluster/service_states
keepalived=1
owsync=1
lease-sync=1
== firewall rules of the cluster
firewall.ha_cluster_vrrp_1=rule
firewall.ha_cluster_vrrp_1.name='HA-Cluster-VRRP-lan'
firewall.ha_cluster_vrrp_1.src='*'
firewall.ha_cluster_vrrp_1.device='lan'
firewall.ha_cluster_vrrp_1.direction='in'
firewall.ha_cluster_vrrp_1.proto='112'
firewall.ha_cluster_vrrp_1.target='ACCEPT'
firewall.ha_cluster_owsync=rule
firewall.ha_cluster_owsync.name='HA-Cluster-owsync'
firewall.ha_cluster_owsync.src='*'
firewall.ha_cluster_owsync.proto='tcp'
firewall.ha_cluster_owsync.src_ip='172.30.0.10' '172.30.0.11'
firewall.ha_cluster_owsync.dest_port='4321'
firewall.ha_cluster_owsync.target='ACCEPT'
firewall.ha_cluster_kea=rule
firewall.ha_cluster_kea.name='HA-Cluster-Kea-HA'
firewall.ha_cluster_kea.src='*'
firewall.ha_cluster_kea.proto='tcp'
firewall.ha_cluster_kea.src_ip='172.30.0.10' '172.30.0.11'
firewall.ha_cluster_kea.dest_port='8001'
firewall.ha_cluster_kea.target='ACCEPT'
firewall.ha_cluster_kea_drop=rule
firewall.ha_cluster_kea_drop.name='HA-Cluster-Kea-HA-drop'
firewall.ha_cluster_kea_drop.src='*'
firewall.ha_cluster_kea_drop.proto='tcp'
firewall.ha_cluster_kea_drop.dest_port='8001'
firewall.ha_cluster_kea_drop.target='DROP'
firewall.ha_cluster_ping=rule
firewall.ha_cluster_ping.name='HA-Cluster-ping'
firewall.ha_cluster_ping.src='*'
firewall.ha_cluster_ping.proto='icmp'
firewall.ha_cluster_ping.icmp_type='echo-request'
firewall.ha_cluster_ping.src_ip='172.30.0.10' '172.30.0.11'
firewall.ha_cluster_ping.target='ACCEPT'
== rc.d
K91ha-cluster
S25ha-cluster
