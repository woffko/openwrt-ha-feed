== uci
package ha-cluster

config global 'config'
	option enabled '1'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'
	option encryption_key '7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e'
	option dhcp_backend 'kea'
	option bind_address '172.30.0.10'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	option priority '200'
	option nopreempt '0'
	option advert_int '1'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'

config service 'dhcp'
	option enabled '1'
	option sync_leases '1'
	list config_files 'dhcp'

config service 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'

package dhcp

config dnsmasq
	option domain 'lan'
	option leasefile '/tmp/dhcp.leases'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'

== uci after migration
package ha-cluster

config global 'config'
	option enabled '1'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'
	option encryption_key '7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e'
	option dhcp_backend 'kea'
	option bind_address '172.30.0.10'
	option lease_sync '1'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	option priority '200'
	option nopreempt '0'
	option advert_int '1'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'

config sync_group 'dhcp'
	option enabled '1'
	list config_files 'dhcp'

config sync_group 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'

== start_service
instance [keepalived]
	set [command] [/usr/sbin/keepalived]
	append [command] [-n]
	append [command] [-f] [/var/run/ha-cluster/keepalived.conf]
	set [file] [/var/run/ha-cluster/keepalived.conf]
	set [reload_signal] [HUP]
	set [respawn]
	set [stdout] [1]
	set [stderr] [1]
end
instance [monitor]
	set [command] [/usr/lib/ha-cluster/role] [monitor]
	set [respawn]
end
instance [owsync]
	set [command] [/usr/bin/owsync] [daemon]
	append [command] [-c] [/var/run/ha-cluster/owsync.conf]
	set [file] [/var/run/ha-cluster/owsync.conf]
	set [respawn]
	set [stdout] [1]
	set [stderr] [1]
end
rc=0
== service_triggers
reload_trigger [ha-cluster]
raw_trigger [kea.service] [1000] [/etc/init.d/ha-cluster] [kea_changed]
config_trigger [config.change] [dhcp] [/etc/init.d/ha-cluster] [dhcp_changed]
config_trigger [config.change] [firewall] [/etc/init.d/ha-cluster] [firewall_changed]
== log
ha-cluster|daemon.info|Starting HA cluster
ha-cluster|daemon.info|Applying HA cluster configuration
ha-cluster|daemon.warning|Kea is the DHCP server of the cluster but neither kea-dhcp4 nor kea-dhcp6 is installed
ha-cluster|daemon.info|lease_sync is not used with Kea as the DHCP server: Kea replicates its leases itself
ha-cluster|daemon.warning|dnsmasq still answers DHCPv4 on interface 'lan' (dhcp.lan) while Kea is the DHCP server
ha-cluster|daemon.warning|Set dhcp.lan.dhcpv4='disabled' to keep its router advertisements, or dhcp.lan.ignore='1'
ha-cluster|daemon.warning|Kea's high availability listens on port 22 (a "url" in its config), which the firewall rule of the cluster does not open: below 1024, or a port of owsync or lease-sync. Give Kea another port
ha-cluster|daemon.warning|Kea's high availability listens on port 4321 (a "url" in its config), which the firewall rule of the cluster does not open: below 1024, or a port of owsync or lease-sync. Give Kea another port
ha-cluster|daemon.info|Taking over service management from standalone init scripts
ha-cluster|daemon.info|Disabled standalone service: keepalived
ha-cluster|daemon.info|Disabled standalone service: owsync
