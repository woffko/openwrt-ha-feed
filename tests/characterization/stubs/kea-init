#!/bin/sh
# Stands in for /etc/init.d/kea (KEA_INIT). Each call is recorded in
# /tmp/fake-kea-init.log. Whether it is enabled is kept in
# /tmp/fake-kea-enabled, which starts as $FAKE_KEA_ENABLED (0 or 1). start,
# restart and reload "run" kea-dhcp4, listing it in /tmp/fake-running (read
# by the pgrep stand-in), when /etc/config/kea enables dhcp4 and
# $FAKE_KEA_FAILS is not set; stop ends it.
log=/tmp/fake-kea-init.log
state=/tmp/fake-kea-enabled
running=/tmp/fake-running
[ -e "$state" ] || echo "${FAKE_KEA_ENABLED:-0}" > "$state"
echo "$*" >> "$log"

dhcp4_stop() {
	[ -e "$running" ] || return 0
	grep -v -x kea-dhcp4 "$running" > "$running.new"
	mv "$running.new" "$running"
}

dhcp4_start() {
	dhcp4_stop
	[ -z "$FAKE_KEA_FAILS" ] || return 0
	[ "$(uci -q get kea.dhcp4.disabled)" = "0" ] || return 0
	echo kea-dhcp4 >> "$running"
}

case "$1" in
	enabled) [ "$(cat "$state")" = "1" ] ;;
	enable) echo 1 > "$state" ;;
	disable) echo 0 > "$state" ;;
	start|restart|reload) dhcp4_start ;;
	stop) dhcp4_stop ;;
	*) exit 1 ;;
esac
