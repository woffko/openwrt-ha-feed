config global 'config'
	option enabled '1'
	option node_priority '100'
	option sync_method 'owsync'
	option encryption_key '00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	list track_script 'check_cmd'

config vrrp_instance 'vpn'
	option vrid '52'
	option interface 'backend'
	list track_script 'check_cmd'

config vip 'vip_lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config vip 'vip_vpn'
	option enabled '1'
	option vrrp_instance 'vpn'
	option interface 'backend'
	option address '172.30.0.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'
	option source_address '172.30.0.10'

config script 'check_cmd'
	option script '/bin/ping -c 1 -W 1 192.168.50.1'
	option interval '5'
	option timeout '2'

config script 'dp_both'
	option check_type 'dataplane'
	list vrrp_instance 'main'
	list vrrp_instance 'vpn'
	option interface 'br-lan'
	list target '192.168.50.20'
	option min_success '1'
	option probe_timeout '1'
	option interval '2'
	option timeout '3'

config script 'dp_vpn'
	option check_type 'dataplane'
	list vrrp_instance 'vpn'
	option interface 'br-lan'
	list target '192.168.50.21'
	option min_success '1'
	option probe_timeout '1'
	option interval '2'
	option timeout '3'
