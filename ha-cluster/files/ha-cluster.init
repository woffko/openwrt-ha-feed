#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Pierre Gaufillet <pierre.gaufillet@bergamote.eu>

# After dnsmasq (19) and network (20)
START=25
STOP=91

USE_PROCD=1

EXTRA_COMMANDS="firewall"
EXTRA_HELP="	firewall	Bring the rules of the cluster in the firewall config up to date"

HA_CLUSTER_LIB="${IPKG_INSTROOT}/usr/lib/ha-cluster/ha-cluster.sh"
[ -r "$HA_CLUSTER_LIB" ] || HA_CLUSTER_LIB="/usr/lib/ha-cluster/ha-cluster.sh"
. "$HA_CLUSTER_LIB"

start_service() {
	local enabled

	ha_log_init

	# A config of the releases before 2.0 reads here as one with no file and
	# no lease sync: migrated first, as the upgrade does. The cluster starts
	# even if that fails, as it would have: without sync, but with VRRP.
	ha_migrate_earlier_model

	config_load ha-cluster
	config_get_bool enabled config enabled 0

	[ "$enabled" -eq 0 ] && {
		ha_log_debug "HA cluster disabled"
		return 0
	}

	ha_log_info "Starting HA cluster"

	# Ensure runtime directories exist (must be before ha_apply_config).
	# The run directory holds generated configs with keys and passwords:
	# root-only, and never a directory someone else created or linked.
	mkdir -p /etc/owsync
	[ -L "$HA_CLUSTER_RUN_DIR" ] && rm -f "$HA_CLUSTER_RUN_DIR"
	mkdir -m 0700 -p "$HA_CLUSTER_RUN_DIR"
	chmod 0700 "$HA_CLUSTER_RUN_DIR"
	# -O: owned by the effective user, which is root here. Not stat(1): the
	# default BusyBox of OpenWrt has no such applet.
	[ -d "$HA_CLUSTER_RUN_DIR" ] && [ -O "$HA_CLUSTER_RUN_DIR" ] || {
		ha_log_error "$HA_CLUSTER_RUN_DIR is not owned by root; refusing to start"
		HA_START_FAILED=1
		return 1
	}

	ha_apply_config || {
		ha_log_error "Failed to apply configuration"
		HA_START_FAILED=1
		return 1
	}

	# What the peers must reach on this node, as rules in the firewall config
	ha_apply_firewall

	ha_log_info "Starting keepalived daemon"
	procd_open_instance keepalived
	procd_set_param command /usr/sbin/keepalived
	procd_append_param command -n  # don't daemonize
	procd_append_param command -f "$KEEPALIVED_CONF"
	procd_set_param file "$KEEPALIVED_CONF"
	procd_set_param reload_signal HUP
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ -f "$OWSYNC_CONF" ]; then
		ha_log_info "Starting owsync daemon"
		procd_open_instance owsync
		procd_set_param command "$OWSYNC_BIN" daemon
		procd_append_param command -c "$OWSYNC_CONF"
		procd_set_param file "$OWSYNC_CONF"
		procd_set_param respawn
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	if [ -f "$LEASE_SYNC_CONF" ]; then
		ha_log_info "Starting lease-sync daemon"
		procd_open_instance lease-sync
		procd_set_param command "$LEASE_SYNC_BIN"
		procd_append_param command -c "$LEASE_SYNC_CONF"
		procd_set_param file "$LEASE_SYNC_CONF"
		procd_set_param respawn
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	return 0
}

# Runs after start_service, on start and on reload. rc.common gives its
# return code as that of "start" and "reload": a start that failed
# (validation, the run directory) fails them too, for LuCI's apply and for
# whoever reloads by hand. Before, both returned 0 with no daemon running.
service_started() {
	ha_reconcile_ipv6_guard
	[ -z "${HA_START_FAILED:-}" ]
}

stop_service() {
	ha_log_info "Stopping HA cluster"

	# procd stops the instances
	return 0
}

# Runs after procd_kill, which only signals the instances. lease-sync must
# be gone before dnsmasq restarts and replays its leases, and the
# standalone daemons need the ports back. procd sends SIGKILL after
# term_timeout (5 s).
service_stopped() {
	local i=0

	while procd_running ha-cluster && [ "$i" -lt 10 ]; do
		sleep 1
		i=$((i + 1))
	done

	# Before dnsmasq restarts on its own, and now that keepalived can no
	# longer report a state: closed for a node that only stops, removed
	# for a node that leaves the cluster
	ha_stop_ipv6_guard

	# Kept for a node that only stops, removed for one that leaves
	ha_stop_firewall

	ha_release_dnsmasq

	ha_manage_services "release"
}

reload_service() {
	local enabled

	config_load ha-cluster
	config_get_bool enabled config enabled 0

	ha_log_init

	ha_log_info "Reloading HA cluster configuration"

	if ! procd_running ha-cluster; then
		if [ "$enabled" -eq 1 ]; then
			ha_log_info "Service not running, performing full start"
			start
			return
		fi
		return 0
	fi

	if [ "$enabled" -eq 0 ]; then
		ha_log_info "HA cluster disabled, stopping"
		stop
		return 0
	fi

	# Regenerate configs and let procd reconcile the instances: owsync and
	# lease-sync restart on config file change or start/stop as their config
	# appears/disappears; keepalived gets SIGHUP on config file change and
	# re-reads its config, keeping the VIPs.
	start
}

service_triggers() {
	procd_add_reload_trigger "ha-cluster"
}

# /etc/init.d/ha-cluster firewall
# Brings the rules of the cluster in /etc/config/firewall up to date and
# touches nothing else: no daemon is started, stopped or signalled, whether
# the service runs or not. For what changes outside the config of
# ha-cluster, such as the ports of Kea's high availability: "reload" would
# start a service that was stopped on purpose.
# Nothing happens for a cluster that is switched off: its rules went when
# it was switched off.
firewall() {
	local enabled

	config_load ha-cluster
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	ha_log_init
	ha_apply_firewall
}
