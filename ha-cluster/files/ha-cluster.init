#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Pierre Gaufillet <pierre.gaufillet@bergamote.eu>

# After dnsmasq (19) and network (20)
START=25
STOP=91

USE_PROCD=1

EXTRA_COMMANDS="firewall kea_changed dhcp_changed maintenance"
EXTRA_HELP="	firewall	Bring the rules of the cluster in the firewall config up to date
	kea_changed	Kea was started or stopped: check the DHCP server of the cluster
	dhcp_changed	/etc/config/dhcp changed: follow a switch of the DHCP server made on the other node
	maintenance	temp|on|off [force]: hand this node's roles to the peer until reboot (temp) or until off (on), or take them back"

HA_CLUSTER_LIB="${IPKG_INSTROOT}/usr/lib/ha-cluster/ha-cluster.sh"
[ -r "$HA_CLUSTER_LIB" ] || HA_CLUSTER_LIB="/usr/lib/ha-cluster/ha-cluster.sh"
. "$HA_CLUSTER_LIB"

start_service() {
	local enabled

	ha_log_init

	# A config of the releases before 2.0 reads here as one with no file and
	# no lease sync: migrated first, as the upgrade does. The cluster starts
	# even if that fails, as it would have: without sync, but with VRRP.
	ha_migrate_earlier_model

	config_load ha-cluster
	config_get_bool enabled config enabled 0

	[ "$enabled" -eq 0 ] && {
		ha_log_debug "HA cluster disabled"
		return 0
	}

	ha_log_info "Starting HA cluster"
	# keepalived and the monitor come back with this start: the mark of a
	# sysupgrade hand-over has done its work
	rm -f "$HA_ROLE_DIR/sysupgrade"

	# Ensure runtime directories exist (must be before ha_apply_config).
	# The run directory holds generated configs with keys and passwords:
	# root-only, and never a directory someone else created or linked.
	mkdir -p /etc/owsync
	[ -L "$HA_CLUSTER_RUN_DIR" ] && rm -f "$HA_CLUSTER_RUN_DIR"
	mkdir -m 0700 -p "$HA_CLUSTER_RUN_DIR"
	chmod 0700 "$HA_CLUSTER_RUN_DIR"
	# -O: owned by the effective user, which is root here. Not stat(1): the
	# default BusyBox of OpenWrt has no such applet.
	[ -d "$HA_CLUSTER_RUN_DIR" ] && [ -O "$HA_CLUSTER_RUN_DIR" ] || {
		ha_log_error "$HA_CLUSTER_RUN_DIR is not owned by root; refusing to start"
		HA_START_FAILED=1
		return 1
	}

	# dnsmasq or Kea for the cluster interfaces, switched if asked for:
	# before the rest, which depends on it (lease-sync, the dnsmasq overlay,
	# the checks of the DHCP config)
	ha_apply_dhcp_backend
	config_load ha-cluster

	ha_apply_config || {
		ha_log_error "Failed to apply configuration"
		HA_START_FAILED=1
		return 1
	}

	# What the peers must reach on this node, as rules in the firewall config
	ha_apply_firewall

	# The interfaces that follow the role: their auto, before keepalived
	# reports a state
	config_load ha-cluster
	ha_apply_uplinks

	ha_log_info "Starting keepalived daemon"
	procd_open_instance keepalived
	procd_set_param command /usr/sbin/keepalived
	procd_append_param command -n  # don't daemonize
	procd_append_param command -f "$KEEPALIVED_CONF"
	procd_set_param file "$KEEPALIVED_CONF"
	procd_set_param reload_signal HUP
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# The uplinks in line between keepalived's reports: netifd that stopped
	# retrying, an interface brought up by hand on a node that is not MASTER.
	# With Kea also without uplinks: the monitor puts a Kea that was
	# restarted during a maintenance back in-maintenance.
	if [ -n "$(ha_uplinks)" ] || ha_dhcp_backend_is_kea; then
		procd_open_instance monitor
		procd_set_param command "$HA_ROLE_BIN" monitor
		procd_set_param respawn
		procd_close_instance
	fi

	if [ -f "$OWSYNC_CONF" ]; then
		ha_log_info "Starting owsync daemon"
		procd_open_instance owsync
		procd_set_param command "$OWSYNC_BIN" daemon
		procd_append_param command -c "$OWSYNC_CONF"
		procd_set_param file "$OWSYNC_CONF"
		procd_set_param respawn
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	if [ -f "$LEASE_SYNC_CONF" ]; then
		ha_log_info "Starting lease-sync daemon"
		procd_open_instance lease-sync
		procd_set_param command "$LEASE_SYNC_BIN"
		procd_append_param command -c "$LEASE_SYNC_CONF"
		procd_set_param file "$LEASE_SYNC_CONF"
		procd_set_param respawn
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	return 0
}

# Runs after start_service, on start and on reload. rc.common gives its
# return code as that of "start" and "reload": a start that failed
# (validation, the run directory) fails them too, for LuCI's apply and for
# whoever reloads by hand. Before, both returned 0 with no daemon running.
service_started() {
	ha_reconcile_ipv6_guard
	if [ -z "${HA_START_FAILED:-}" ]; then
		# No state of an instance the new config no longer has
		ha_role_prune
		# The uplinks in line with the states recorded: keepalived reports
		# no state that a reload keeps
		config_load ha-cluster
		# In the background without rc.common's lock (descriptor 1000):
		# the reconcile waits for an up_delay that runs, and would hold
		# every other call of this script up for as long
		[ -n "$(ha_uplinks)" ] && "$HA_ROLE_BIN" reconcile </dev/null >/dev/null 2>&1 1000>&- &
		# Kea back in-maintenance once it has joined its partner
		[ "$(ha_maintenance_mode)" != "none" ] && ha_maintenance_kea_resume_bg
	fi
	[ -z "${HA_START_FAILED:-}" ]
}

stop_service() {
	local enabled

	ha_log_info "Stopping HA cluster"

	# The 'master' uplinks down while keepalived still holds the role, in
	# the order of a maintenance: keepalived says goodbye when procd ends
	# it, the peer is MASTER within a second and dials, and found the login
	# still held for the seconds until service_stopped had closed the
	# session (one CHAP refusal at every stop, restart and reboot of the
	# MASTER). service_stopped removes the hold.
	config_load ha-cluster
	config_get_bool enabled config enabled 0
	if [ "$enabled" -eq 1 ] && [ -n "$(ha_uplinks)" ] && procd_running ha-cluster keepalived &&
		ha_ensure_run_dir && mkdir -p "$HA_ROLE_DIR"; then
		: > "$HA_ROLE_DIR/hold"
		ha_role_locked ha_uplinks_reconcile
	fi

	# procd stops the instances
	return 0
}

# Runs after procd_kill, which only signals the instances. lease-sync must
# be gone before dnsmasq restarts and replays its leases, and the
# standalone daemons need the ports back. procd sends SIGKILL after
# term_timeout (5 s).
service_stopped() {
	local i=0

	while procd_running ha-cluster && [ "$i" -lt 10 ]; do
		sleep 1
		i=$((i + 1))
	done

	# Before dnsmasq restarts on its own, and now that keepalived can no
	# longer report a state: closed for a node that only stops, removed
	# for a node that leaves the cluster
	ha_stop_ipv6_guard

	# The 'master' uplinks down for a node that only stops, their auto back
	# for one that leaves
	ha_stop_uplinks

	# Kept for a node that only stops, ended for one that leaves
	ha_stop_maintenance

	# A Kea kept in-maintenance for a FAULT or a lost sync link comes back
	ha_stop_kea_aside

	# Kept for a node that only stops, removed for one that leaves
	ha_stop_firewall

	ha_release_dnsmasq

	ha_manage_services "release"
}

# Taking the service out of boot takes the node out of the cluster. A stop
# done before kept, for a node that stays, what it closed: the IPv6 guard,
# the firewall rules, the uplinks with their auto '0', a maintenance. They
# are released here, as the stop of a node that leaves does; a running
# service releases them at the stop that follows (the package's prerm).
disable() {
	rm -f "${IPKG_INSTROOT}"/etc/rc.d/S??ha-cluster "${IPKG_INSTROOT}"/etc/rc.d/K??ha-cluster
	[ -z "${IPKG_INSTROOT}" ] || return 0
	procd_running ha-cluster && return 0
	ha_log_init
	ha_stop_ipv6_guard
	ha_stop_uplinks
	ha_stop_maintenance
	ha_stop_firewall
	return 0
}

reload_service() {
	local enabled

	config_load ha-cluster
	config_get_bool enabled config enabled 0

	ha_log_init

	ha_log_info "Reloading HA cluster configuration"

	if ! procd_running ha-cluster; then
		if [ "$enabled" -eq 1 ]; then
			ha_log_info "Service not running, performing full start"
			start
			return
		fi
		return 0
	fi

	if [ "$enabled" -eq 0 ]; then
		ha_log_info "HA cluster disabled, stopping"
		stop
		return 0
	fi

	# Regenerate configs and let procd reconcile the instances: owsync and
	# lease-sync restart on config file change or start/stop as their config
	# appears/disappears; keepalived gets SIGHUP on config file change and
	# re-reads its config, keeping the VIPs.
	start
}

service_triggers() {
	procd_add_reload_trigger "ha-cluster"
	# luci-app-kea sends it after it started, restarted, reloaded or stopped
	# Kea
	procd_add_raw_trigger "kea.service" 1000 /etc/init.d/ha-cluster kea_changed
	# reload_config sends it for dhcp: after LuCI's apply, and after owsync
	# took the file from a peer (owsync-changed)
	procd_add_config_trigger "config.change" "dhcp" /etc/init.d/ha-cluster dhcp_changed
}

# /etc/init.d/ha-cluster firewall
# Brings the rules of the cluster in /etc/config/firewall up to date and
# touches nothing else: no daemon is started, stopped or signalled, whether
# the service runs or not. For what changes outside the config of
# ha-cluster, such as the ports of Kea's high availability: "reload" would
# start a service that was stopped on purpose.
# Nothing happens for a cluster that is switched off: its rules went when
# it was switched off.
firewall() {
	local enabled

	config_load ha-cluster
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	ha_log_init
	ha_apply_firewall
}

# /etc/init.d/ha-cluster kea_changed
# Run by procd when luci-app-kea has started, restarted, reloaded or stopped
# Kea: notes whether Kea was stopped on purpose, and has a running cluster
# check its DHCP server (a reload). A cluster that is stopped stays stopped:
# that is the difference with the reload trigger of the config.
kea_changed() {
	local enabled

	config_load ha-cluster
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	ha_log_init
	ha_kea_changed
	procd_running ha-cluster || return 0
	reload
}

# /etc/init.d/ha-cluster maintenance temp|on|off [force]
# temp: this node hands its VRRP roles, DHCP (Kea) and 'master' uplinks to
# the peer and takes none until "off" or the next reboot. on: the same,
# kept across reboots and upgrades; the node stays the last candidate and
# takes the roles only when the peer is gone. off: back to normal. Refused
# while the peer could not take over, unless forced. Without an argument:
# prints the mode (none, temp, persistent).
maintenance() {
	local action="$1" force="$2" mode out rc

	ha_log_init
	case "$action" in
		""|status)
			ha_maintenance_mode
			return 0
			;;
		temp) mode="temp" ;;
		on|persistent) mode="persistent" ;;
		off) mode="" ;;
		*)
			echo "Usage: $0 maintenance temp|on|off [force]" >&2
			return 1
			;;
	esac
	[ "$force" = "force" ] || force=""
	ha_ensure_run_dir || return 1
	# One at a time (LuCI, the command line, a sysupgrade), and what each
	# said, for the status
	exec 8>>"$HA_MAINTENANCE_LOCK"
	if ! flock -n -x 8; then
		echo "Another maintenance command is still running"
		exec 8>&-
		return 1
	fi
	# Not cut short by Ctrl-C or a lost SSH session: a hand-over stopped in
	# the middle left the 'master' uplinks held and, in persistent mode,
	# the node in FAULT instead of the last candidate
	trap '' INT HUP
	echo "$(date '+%Y-%m-%d %H:%M:%S') maintenance $action${force:+ $force}: running" > "$HA_MAINTENANCE_LAST"
	if [ -n "$mode" ]; then
		out="$(ha_maintenance_enter "$mode" "$force")"
	else
		out="$(ha_maintenance_leave)"
	fi
	rc=$?
	if [ "$rc" -eq 0 ]; then
		# keepalived's config with the files of the maintenance, or without.
		# After a sysupgrade that did not go on, keepalived and the monitor
		# are out of procd and perhaps nothing of the service runs: a start
		# brings them back.
		if procd_running ha-cluster; then
			reload >/dev/null 2>&1
		elif [ -e "$HA_ROLE_DIR/sysupgrade" ]; then
			start >/dev/null 2>&1
		fi
		rm -f "$HA_ROLE_DIR/sysupgrade"
		# LuCI's web server, which the hook of a sysupgrade stopped: back
		# at once, and the hook's timer does nothing without its mark
		if [ -e "$HA_UHTTPD_RESTORE" ]; then
			rm -f "$HA_UHTTPD_RESTORE"
			[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd start >/dev/null 2>&1
		fi
		ha_maintenance_settle
	fi
	[ -n "$out" ] && echo "$out"
	echo "$(date '+%Y-%m-%d %H:%M:%S') maintenance $action${force:+ $force}: $(printf '%s\n' "$out" | tail -n 1)" > "$HA_MAINTENANCE_LAST"
	flock -u 8
	exec 8>&-
	trap - INT HUP
	return "$rc"
}

# /etc/init.d/ha-cluster dhcp_changed
# Run by procd when /etc/config/dhcp changed: after LuCI's apply, and after
# owsync took the file from a peer. With dhcp_backend 'auto' the node
# follows a switch of the DHCP server made on the other node, which the
# synced pools tell (see ha_dhcp_backend_wanted): a running cluster is
# reloaded when its server is not the one asked for, and left alone
# otherwise.
dhcp_changed() {
	local enabled

	config_load ha-cluster
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_running ha-cluster || return 0
	ha_log_init
	ha_dhcp_switch_due || return 0
	ha_log_info "/etc/config/dhcp changed: checking the DHCP server of the cluster interfaces"
	reload
}
