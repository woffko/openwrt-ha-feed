#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Pierre Gaufillet <pierre.gaufillet@bergamote.eu>
# Brings a node that keeps its files across an upgrade in line with this
# release. Puts the IPv6 BACKUP guard handler and the role handler of this
# release back and removes the hooks of keepalived-sync left without that
# package, then migrates /etc/config/ha-cluster to sync_group sections, the global
# lease_sync switch, vrrp_only peers and a named advanced section, and
# drops the lease-sync persist interval. Idempotent.
# Also installed as /usr/lib/ha-cluster/migrate-config: the init script
# runs it when the files it changes were put back after the first boot.

# sysupgrade keeps every file of /etc/hotplug.d/keepalived/, for the custom
# hooks that directory may hold. The handler this package installs there is
# kept with them, and the copy of the previous image then replaces the one
# of the new image. Put the handler of this release back from its copy
# outside that directory, and drop the handlers of earlier releases, which
# it has replaced.
HOOKS="/etc/hotplug.d/keepalived"
GUARD="/usr/lib/ha-cluster/ipv6-backup-guard"
if [ -f "$GUARD" ] && ! cmp -s "$GUARD" "$HOOKS/20-ipv6-backup-guard"; then
	mkdir -p "$HOOKS"
	cp "$GUARD" "$HOOKS/20-ipv6-backup-guard"
	chmod 0755 "$HOOKS/20-ipv6-backup-guard"
fi
rm -f "$HOOKS/20-dhcpv6-backup-guard" "$HOOKS/21-RA-backup-guard"

# The same for the role handler, which LuCI's hook editor can also delete
ROLE_HOOK="/usr/lib/ha-cluster/role.hotplug"
if [ -f "$ROLE_HOOK" ] && ! cmp -s "$ROLE_HOOK" "$HOOKS/10-ha-cluster-role"; then
	mkdir -p "$HOOKS"
	cp "$ROLE_HOOK" "$HOOKS/10-ha-cluster-role"
	chmod 0755 "$HOOKS/10-ha-cluster-role"
fi

# The hooks of keepalived-sync, kept from an image that had the package:
# each loads its library, and fails at every state change without it.
# Only those files go, not custom hooks of the same name.
if [ ! -f "${HA_SYNC_HOOK_LIB:-/lib/functions/keepalived/hotplug.sh}" ]; then
	for hook in 501-rpcd 505-system 511-firewall 551-dnsmasq 555-dropbear 600-uhttpd 700-luci 810-files; do
		[ -f "$HOOKS/$hook" ] &&
			grep -q '^\. /lib/functions/keepalived/hotplug\.sh' "$HOOKS/$hook" &&
			rm -f "$HOOKS/$hook"
	done
fi

. /lib/functions.sh

CONFIG="${UCI_CONFIG_DIR:-/etc/config}/ha-cluster"
[ -f "$CONFIG" ] || exit 0

# Section type only: keeps anonymous sections anonymous
sed -i -E \
	-e "s/^([[:space:]]*config[[:space:]]+)service([[:space:]]|$)/\1sync_group\2/" \
	-e "s/^([[:space:]]*config[[:space:]]+)'service'/\1'sync_group'/" \
	-e "s/^([[:space:]]*config[[:space:]]+)\"service\"/\1\"sync_group\"/" \
	"$CONFIG"

config_load ha-cluster

# Only the dhcp group's switch was read
migrate_sync_leases() {
	local section="$1"
	local value

	config_get value "$section" sync_leases
	[ -z "$value" ] && return 0

	if [ "$section" = "dhcp" ] && [ -z "$(uci -q get ha-cluster.config.lease_sync)" ]; then
		config_get_bool value "$section" sync_leases 0
		uci -q set ha-cluster.config.lease_sync="$value"
	fi
	uci -q delete "ha-cluster.$section.sync_leases"
}
config_foreach migrate_sync_leases sync_group

# Any sync_method other than owsync turned file sync off
disable_sync_group() {
	uci -q set "ha-cluster.$1.enabled=0"
}
sync_method="$(uci -q get ha-cluster.config.sync_method)"
if [ -n "$sync_method" ] && [ "$sync_method" != "owsync" ]; then
	config_foreach disable_sync_group sync_group
	uci -q delete ha-cluster.config.sync_method
fi

migrate_peer() {
	local section="$1"
	local value

	config_get value "$section" sync_enabled
	[ -z "$value" ] && return 0

	config_get_bool value "$section" sync_enabled 1
	[ "$value" -eq 0 ] && uci -q set "ha-cluster.$section.vrrp_only=1"
	uci -q delete "ha-cluster.$section.sync_enabled"
}
config_foreach migrate_peer peer

# The backend reads the advanced section by name: the first anonymous
# one takes it, unless a section already has it
if [ -z "$(uci -q get ha-cluster.advanced)" ]; then
	section="$(uci -q show ha-cluster |
		sed -n 's/^ha-cluster\.\(@advanced\[[0-9]*\]\)=advanced$/\1/p' |
		head -n 1)"
	[ -n "$section" ] && uci -q rename "ha-cluster.$section=advanced"
fi

# Never implemented by lease-sync
uci -q delete ha-cluster.advanced.lease_sync_persist_interval

uci -q commit ha-cluster
exit 0
