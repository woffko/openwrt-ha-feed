--- a/include/common.h
+++ b/include/common.h
@@ -38,6 +38,7 @@ typedef enum {
     OWSYNC_ERROR_CLOCK_SKEW = -6,    /* Peer clock difference exceeds threshold */
     OWSYNC_ERROR_VERSION_MISMATCH = -7, /* Protocol version mismatch */
     OWSYNC_ERROR_INCOMPLETE = -8,    /* Session ran to its end, but not every file was applied or sent */
+    OWSYNC_ERROR_BUSY = -9,          /* Another session is running: nothing was done, try again */
 } owsync_error_t;
 
 /* Dynamic byte buffer with automatic growth */
diff -ru a/include/net.h b/include/net.h
--- a/include/net.h
+++ b/include/net.h
@@ -88,6 +88,28 @@ void net_set_allowed_peers(char **peers, size_t count);
  */
 void net_set_on_change(const char *path);
 
+/*
+ * One session at a time works on the sync directory and the database, in
+ * this process and (through a lock file next to the database) across the
+ * processes that share them. With wait a caller blocks until the session
+ * that runs has ended; without, it gets OWSYNC_ERROR_BUSY at once.
+ * net_session_leave() ends what a successful net_session_enter() began.
+ */
+int net_session_enter(const char *db_path, bool wait);
+void net_session_leave(void);
+
+/*
+ * True, once, when something happened that leaves a peer without what
+ * this node has, or this node without what a peer has, and no session of
+ * this node's own will follow by itself: a session a peer started ended
+ * badly or was turned away, or a session's scan found a change the poller
+ * has not seen. The daemon then syncs to its peers again.
+ */
+bool net_take_resync_request(void);
+
+/* Repeated failures to reach a peer are logged at debug level only */
+void net_set_connect_quiet(bool quiet);
+
 /* Server mode: listen for incoming connections, spawn threads */
 int start_server(const char *host, const char *port, const char *key,
                  const char *root, const char *db_path, file_filter_t *filter,
