+    struct timespec hello_t0, hello_t1;
+    clock_gettime(CLOCK_MONOTONIC, &hello_t0);
+    int hello_rc = channel_receive(channel, &peer_hello);
+    if (hello_rc != OWSYNC_OK) {
+        clock_gettime(CLOCK_MONOTONIC, &hello_t1);
+        long waited_ms = (long)(hello_t1.tv_sec - hello_t0.tv_sec) * 1000 +
+                         (hello_t1.tv_nsec - hello_t0.tv_nsec) / 1000000;
+        /*
+         * A peer that is at work on another session closes a connection
+         * at once, before its greeting: often the session it has just
+         * started to this very node. No error, then, the first few times
+         * (the caller counts); a peer that does not know this node's
+         * address looks the same. Only that: a peer that stays silent
+         * until the timeout, a greeting that cannot be read (another
+         * key, encrypted against plain) are errors and are said as such.
+         */
+        if (hello_rc == OWSYNC_ERROR_IO && waited_ms < 2000) {
+            if (connect_quiet) {
+                log_debug("No greeting from the peer");
+            } else {
+                log_info("No greeting from the peer: it closed the connection "
+                         "(at work on another session, or this node is not one of its peers)");
+            }
+            return OWSYNC_ERROR_REFUSED;
+        }
+        if (hello_rc == OWSYNC_ERROR_CRYPTO) {
+            log_reach("The peer's greeting cannot be decrypted: its key is not this node's");
+            return OWSYNC_ERROR_CRYPTO;
+        }
+        if (hello_rc == OWSYNC_ERROR_IO) {
+            log_reach("Failed to receive Hello: the peer did not greet within %ld s", waited_ms / 1000);
+            return OWSYNC_ERROR_IO;
+        }
+        log_reach("Failed to receive Hello: not a greeting this node can read "
+                  "(a peer that encrypts while this node does not, or the other way round?)");
+        return OWSYNC_ERROR_PROTOCOL;
