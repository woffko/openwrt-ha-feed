+    uint8_t *output = malloc(encrypted_len + EVP_MAX_BLOCK_LENGTH + 1);
     if (!output) {
         return OWSYNC_ERROR_MEMORY;
     }
@@ -181,6 +182,7 @@
         return OWSYNC_ERROR_CRYPTO;
     }
     total_len += len;
+    output[total_len] = '\0';
 
     *plaintext = output;
     *plaintext_len = total_len;
diff -ruN owsync-1.2.0/owsync-1.2.0/src/daemon.c owsync-work/src/daemon.c
--- a/src/daemon.c	2026-02-11 23:25:14.000000000 +0200
+++ b/src/daemon.c	2026-10-22 20:51:11.263702256 +0300
@@ -279,6 +279,9 @@
 
     log_info("Starting listen server on %s:%s", ctx->host, ctx->port);
 
+    /* Only the configured peers may open sync sessions */
+    net_set_allowed_peers(ctx->peers, ctx->peer_count);
+
     /* start_server runs until process termination */
     int result = start_server(ctx->host, ctx->port, ctx->key, ctx->root,
                               ctx->db_path, ctx->filter, ctx->clock_offset);
