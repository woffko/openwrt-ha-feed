+/*
+ * Accept filter: addresses of the configured peers. Resolved once when the
+ * daemon starts; a connection from any other address is closed before a
+ * worker thread or a receive buffer is spent on it.
+ */
+#define ALLOWED_PEER_ADDRS 64
+static struct sockaddr_storage allowed_peer_addrs[ALLOWED_PEER_ADDRS];
+static size_t allowed_peer_addr_count = 0;
+static bool allowed_peers_configured = false;
+
+void net_set_allowed_peers(char **peers, size_t count) {
+    allowed_peer_addr_count = 0;
+    allowed_peers_configured = (count > 0);
+
+    for (size_t i = 0; i < count; i++) {
+        if (!peers[i]) continue;
+
+        /* Peer format: "addr[,source_addr]" */
+        const char *comma = strchr(peers[i], ',');
+        size_t host_len = comma ? (size_t)(comma - peers[i]) : strlen(peers[i]);
+        char host[256];
+        if (host_len == 0 || host_len >= sizeof(host)) continue;
+        memcpy(host, peers[i], host_len);
+        host[host_len] = '\0';
+
+        struct addrinfo hints = {0};
+        hints.ai_family = AF_UNSPEC;
+        hints.ai_socktype = SOCK_STREAM;
+        struct addrinfo *result = NULL;
+        if (getaddrinfo(host, NULL, &hints, &result) != 0) {
+            log_warning("Accept filter: cannot resolve peer %s", host);
+            continue;
+        }
+        for (struct addrinfo *rp = result;
+                rp && allowed_peer_addr_count < ALLOWED_PEER_ADDRS; rp = rp->ai_next) {
+            if (rp->ai_addrlen > sizeof(struct sockaddr_storage)) continue;
+            memcpy(&allowed_peer_addrs[allowed_peer_addr_count], rp->ai_addr, rp->ai_addrlen);
+            allowed_peer_addr_count++;
+        }
+        freeaddrinfo(result);
+    }
+
+    if (allowed_peers_configured && allowed_peer_addr_count == 0) {
+        log_error("Accept filter: no peer address resolved; incoming connections will be refused");
+    } else {
+        log_info("Accept filter: %zu peer address(es)", allowed_peer_addr_count);
+    }
+}
+
+/* Raw address bytes of a socket address; IPv4-mapped IPv6 counts as IPv4 */
+static int address_bytes(const struct sockaddr_storage *ss, const uint8_t **bytes, size_t *len) {
+    if (ss->ss_family == AF_INET) {
+        *bytes = (const uint8_t *)&((const struct sockaddr_in *)ss)->sin_addr;
+        *len = 4;
+        return 0;
+    }
+    if (ss->ss_family == AF_INET6) {
+        const struct in6_addr *addr = &((const struct sockaddr_in6 *)ss)->sin6_addr;
+        if (IN6_IS_ADDR_V4MAPPED(addr)) {
+            *bytes = (const uint8_t *)addr->s6_addr + 12;
+            *len = 4;
+        } else {
+            *bytes = (const uint8_t *)addr->s6_addr;
+            *len = 16;
+        }
+        return 0;
+    }
+    return -1;
+}
+
+static bool peer_allowed(const struct sockaddr_storage *client) {
+    if (!allowed_peers_configured) return true;
+
+    const uint8_t *client_bytes;
+    size_t client_len;
+    if (address_bytes(client, &client_bytes, &client_len) != 0) return false;
+
+    for (size_t i = 0; i < allowed_peer_addr_count; i++) {
+        const uint8_t *peer_bytes;
+        size_t peer_len;
+        if (address_bytes(&allowed_peer_addrs[i], &peer_bytes, &peer_len) != 0) continue;
+        if (peer_len == client_len && memcmp(peer_bytes, client_bytes, client_len) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void describe_address(const struct sockaddr_storage *ss, char *out, size_t out_len) {
+    const uint8_t *bytes;
+    size_t len;
+    out[0] = '\0';
+    if (address_bytes(ss, &bytes, &len) == 0) {
+        inet_ntop(len == 4 ? AF_INET : AF_INET6, bytes, out, out_len);
+    }
+}
+
+/* A sync session is request/response: a silent peer must not block a slot */
+static void set_io_timeouts(int fd) {
+    struct timeval tv = { .tv_sec = OWSYNC_IO_TIMEOUT_SEC, .tv_usec = 0 };
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+}
+
 /* Thread entry point for handling incoming connections */
 static void *handle_connection(void *arg) {
     connection_args_t *args = (connection_args_t *)arg;
@@ -1056,6 +1181,15 @@
             continue;
         }
 
+        if (!peer_allowed(&client_addr)) {
+            char who[INET6_ADDRSTRLEN];
+            describe_address(&client_addr, who, sizeof(who));
+            log_warning("Refused connection from %s: not a configured peer", who);
+            close(client_fd);
+            continue;
+        }
+        set_io_timeouts(client_fd);
+
         int count = __sync_add_and_fetch(&active_connections, 1);
         if (count > MAX_CONNECTIONS) {
             __sync_sub_and_fetch(&active_connections, 1);
@@ -1160,6 +1294,7 @@
         }
 
         if (connect(sockfd, rp->ai_addr, rp->ai_addrlen) == 0) {
+            set_io_timeouts(sockfd);
             break;  /* Success */
         }
 
