+/* The entry of path in a list of file states, or NULL */
+static file_state_t *find_state(file_state_list_t *list, const char *path) {
+    if (!list || !path) return NULL;
+    for (size_t i = 0; i < list->count; i++) {
+        if (list->files[i].path && strcmp(list->files[i].path, path) == 0) {
+            return &list->files[i];
+        }
+    }
+    return NULL;
+}
+
+/*
+ * The file at full_path is still what this session's scan saw: a regular
+ * file of the same date and size where the scan listed one (was), no
+ * regular file where it listed none or a deletion. A file that was written
+ * here after the scan was not part of the comparison with the peer:
+ * replacing or removing it now would destroy an edit nobody has compared
+ * with anything. What a scan never lists (a link, a special file) is not
+ * such an edit, and gives way to the peer's file as it always did.
+ */
+static bool unchanged_since_scan(const char *full_path, const file_state_t *was) {
+    struct stat st;
+
+    if (lstat(full_path, &st) != 0) {
+        return errno == ENOENT && (!was || was->deleted);
+    }
+    if (!S_ISREG(st.st_mode)) return !was || was->deleted;
+    if (!was || was->deleted) return false;
+
+    uint64_t mtime = (uint64_t)st.st_mtim.tv_sec * 1000 + st.st_mtim.tv_nsec / 1000000;
+    return mtime == was->mtime && (uint64_t)st.st_size == was->size;
+}
