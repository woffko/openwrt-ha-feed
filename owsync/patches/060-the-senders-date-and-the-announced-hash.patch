 }
+
+/* SHA-256 of a buffer, hex-encoded (caller must free). */
+int compute_hash_buf(const uint8_t *data, size_t len, char **out_hash) {
+    if ((!data && len > 0) || !out_hash) return OWSYNC_ERROR;
+
+    uint8_t hash[EVP_MAX_MD_SIZE];
+    unsigned int hash_len = 0;
+
+    if (EVP_Digest(data ? data : (const uint8_t *)"", len, hash, &hash_len, EVP_sha256(), NULL) != 1) {
+        return OWSYNC_ERROR;
+    }
+
+    *out_hash = hex_encode(hash, hash_len);
+    return *out_hash ? OWSYNC_OK : OWSYNC_ERROR_MEMORY;
+}
+
+void database_clamp_future(database_t *db, const char *root, uint64_t now_ms,
+                           uint64_t limit_ms, bool *dirty) {
+    if (!db || !root) return;
+
+    for (size_t i = 0; i < db->bucket_count; i++) {
+        for (db_entry_t *entry = db->buckets[i]; entry; entry = entry->next) {
+            if (entry->state.mtime <= limit_ms) continue;
+
+            if (!entry->state.deleted) {
+                char full_path[MAX_PATH_LEN];
+                if (snprintf(full_path, sizeof(full_path), "%s/%s", root, entry->path) >= (int)sizeof(full_path)) {
+                    continue;
+                }
+                struct timespec times[2];
+                times[0].tv_sec = 0;
+                times[0].tv_nsec = UTIME_OMIT;
+                times[1].tv_sec = (time_t)(now_ms / 1000);
+                times[1].tv_nsec = (long)(now_ms % 1000) * 1000000L;
+                if (utimensat(AT_FDCWD, full_path, times, AT_SYMLINK_NOFOLLOW) != 0) {
+                    log_warning("'%s' is dated in the future and its date cannot be set: %s",
+                                entry->path, strerror(errno));
+                    continue;
+                }
+                log_warning("'%s' was dated in the future (the clock was wrong when it was written): "
+                            "its date is now the present", entry->path);
+                /* What the file system kept of it, as a scan reads it */
+                struct stat st;
+                if (lstat(full_path, &st) == 0) {
+                    entry->state.mtime = (uint64_t)st.st_mtim.tv_sec * 1000 + st.st_mtim.tv_nsec / 1000000;
+                } else {
+                    entry->state.mtime = now_ms;
+                }
+            } else {
+                entry->state.mtime = now_ms;
+            }
+            if (dirty) *dirty = true;
+        }
+    }
+}
