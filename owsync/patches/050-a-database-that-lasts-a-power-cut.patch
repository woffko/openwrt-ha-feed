From: OpenWrt HA build <local>
Subject: [PATCH] owsync: a database that lasts a power cut, temporary files of one's own

Three things a session or a scan left to chance.

The database was written with fopen, fputs, fclose and rename, without a
sync and without a look at what any of them returned. Renaming a file
that was never synced only looks atomic: after a power cut the database
can come back empty. An empty database has forgotten every deletion, and
the next session brings the deleted files back from the peer. It is now
written to a temporary file, synced, renamed, and its directory is
synced; every step is checked and a failure is logged with its reason. A
directory of the database that went missing is made again (one level):
without it nothing is remembered and every scan looks like a change.

The temporary names were fixed: "<database>.db_tmp" and "<file>.tmp".
Two sessions at once, as when both nodes start a session to each other
at the same moment, opened the same temporary file, the second
truncating what the first was about to rename into place. They are now
of the writing thread's own: "<database>.<pid>.<tid>.db_tmp" and, next
to the destination, ".<name>.<pid>.<tid>.tmp". The latter is hidden, so
that a leftover of a crash is not taken by uci, or by a scan, for a
config file of its own.

A file a peer has deleted was unlinked by its path below the sync root as
the peer gave it. It is now removed only where that path resolves inside
the root: a directory below the root that is a link to elsewhere does not
take the removal with it. A removal that fails is not recorded as done.

The wire protocol does not change.

diff -ru a/src/net.c b/src/net.c
--- a/src/net.c
+++ b/src/net.c
@@ -15,6 +15,7 @@
 #include <pthread.h>
 #include <sys/socket.h>
 #include <sys/stat.h>
+#include <sys/syscall.h>
 #include <sys/time.h>
 #include <libgen.h>
 #include <errno.h>
@@ -1008,10 +1009,27 @@ static int handle_protocol(channel_t *channel, const char *root, const char *db_
         char full_path[MAX_PATH_LEN];
         snprintf(full_path, sizeof(full_path), "%s/%s", root, plan->files_to_delete.paths[i]);
 
-        /* Attempt to delete file directly (unlink handles non-existent files safely) */
-        if (unlink(full_path) == 0) {
-            log_info("Deleted: %s", plan->files_to_delete.paths[i]);
-            deletion_performed = true;
+        /*
+         * The path comes from the peer. It is removed only where it
+         * resolves inside the sync root: a directory below the root that
+         * is a link to elsewhere must not take the removal with it. The
+         * file a scan listed is a regular file; one that is gone already
+         * has nothing to remove.
+         */
+        struct stat del_st;
+        if (lstat(full_path, &del_st) == 0) {
+            if (!is_path_safe(root, plan->files_to_delete.paths[i])) {
+                log_warning("Not deleting '%s': resolves outside the sync root",
+                            plan->files_to_delete.paths[i]);
+                continue;
+            }
+            if (unlink(full_path) == 0) {
+                log_info("Deleted: %s", plan->files_to_delete.paths[i]);
+                deletion_performed = true;
+            } else {
+                log_warning("Cannot delete '%s': %s", plan->files_to_delete.paths[i], strerror(errno));
+                continue;
+            }
         }
 
         file_state_t *entry = database_get(db, plan->files_to_delete.paths[i]);
@@ -1189,8 +1207,20 @@ static int handle_protocol(channel_t *channel, const char *root, const char *db_
                 continue;
             }
 
-            char tmp_path[MAX_PATH_LEN + 5];  // +5 for ".tmp\0"
-            if (snprintf(tmp_path, sizeof(tmp_path), "%s.tmp", full_path) >= (int)sizeof(tmp_path)) {
+            /*
+             * A temporary file of this thread's own, next to the
+             * destination: ".<name>.<pid>.<tid>.tmp". Two sessions that
+             * receive the same file at the same moment must not write
+             * into one temporary file: the second would truncate what the
+             * first is about to rename into place. Hidden, so that
+             * nothing that lists the directory (uci, a scan) takes a
+             * leftover of a crash for a file of its own.
+             */
+            char tmp_path[MAX_PATH_LEN + 64];
+            const char *base = strrchr(path, '/');
+            base = base ? base + 1 : path;
+            if (snprintf(tmp_path, sizeof(tmp_path), "%s/.%s.%ld.%ld.tmp", real_dir, base,
+                         (long)getpid(), (long)syscall(SYS_gettid)) >= (int)sizeof(tmp_path)) {
                 message_free(msg);
                 continue;
             }
diff -ru a/src/state.c b/src/state.c
--- a/src/state.c
+++ b/src/state.c
@@ -9,7 +9,9 @@
 #include <errno.h>
 #include <ftw.h>
 #include <sys/stat.h>
+#include <sys/syscall.h>
 #include <unistd.h>
+#include <fcntl.h>
 #include <fnmatch.h>
 #include <openssl/evp.h>
 #include <json-c/json.h>
@@ -372,9 +374,43 @@ int database_load(database_t *db, const char *path) {
     return OWSYNC_OK;
 }
 
+/* Makes what was written to or renamed in the directory of path last a
+ * power cut. Nothing to do about a failure but to say so. */
+static void fsync_parent_dir(const char *path) {
+    char dir[MAX_PATH_LEN];
+
+    if (snprintf(dir, sizeof(dir), "%s", path) >= (int)sizeof(dir)) return;
+    char *slash = strrchr(dir, '/');
+    if (!slash) {
+        strcpy(dir, ".");
+    } else if (slash == dir) {
+        dir[1] = '\0';
+    } else {
+        *slash = '\0';
+    }
+
+    int dirfd = open(dir, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (dirfd < 0) {
+        log_warning("Cannot open directory '%s' to sync it: %s", dir, strerror(errno));
+        return;
+    }
+    if (fsync(dirfd) != 0) {
+        log_warning("Directory fsync failed for '%s': %s", dir, strerror(errno));
+    }
+    close(dirfd);
+}
+
 /*
- * Save database to JSON file atomically.
- * Writes to .db_tmp then renames to prevent corruption on crash.
+ * Save database to JSON file atomically and durably.
+ *
+ * The database is written to a temporary file of this thread's own
+ * ("<path>.<pid>.<tid>.db_tmp": two sessions that save at the same moment
+ * must not write into one file), synced, renamed over the database, and
+ * the directory is synced. Without the syncs the rename only looks atomic:
+ * after a power cut the database can come back empty, and an empty
+ * database has forgotten every deletion, so the peers' copies of deleted
+ * files come back. Every failure is logged here, with the reason, because
+ * no caller can do more about it than try again at the next change.
  */
 int database_save(database_t *db, const char *path) {
     if (!db || !path) return OWSYNC_ERROR;
@@ -429,23 +465,72 @@ int database_save(database_t *db, const char *path) {
     }
 
     char tmp_path[MAX_PATH_LEN];
-    snprintf(tmp_path, sizeof(tmp_path), "%s.db_tmp", path);
+    int n = snprintf(tmp_path, sizeof(tmp_path), "%s.%ld.%ld.db_tmp", path,
+                     (long)getpid(), (long)syscall(SYS_gettid));
+    if (n < 0 || (size_t)n >= sizeof(tmp_path)) {
+        log_error("Cannot save database '%s': path too long", path);
+        json_object_put(root);
+        return OWSYNC_ERROR_IO;
+    }
 
-    FILE *fp = fopen(tmp_path, "w");
-    if (!fp) {
+    int fd = open(tmp_path, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW | O_CLOEXEC, 0644);
+    if (fd < 0 && errno == ENOENT) {
+        /* The directory of the database is gone: without it nothing is
+         * remembered and every scan looks like a change. One level only;
+         * a path that lacks more than that is a wrong path. */
+        char dir[MAX_PATH_LEN];
+        snprintf(dir, sizeof(dir), "%s", path);
+        char *slash = strrchr(dir, '/');
+        if (slash && slash != dir) {
+            *slash = '\0';
+            if (mkdir(dir, 0755) == 0) {
+                log_warning("Directory '%s' of the database was missing: created", dir);
+                fd = open(tmp_path, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW | O_CLOEXEC, 0644);
+            } else {
+                errno = ENOENT;
+            }
+        }
+    }
+    if (fd < 0) {
+        log_error("Cannot save database: open '%s': %s", tmp_path, strerror(errno));
         json_object_put(root);
         return OWSYNC_ERROR_IO;
     }
 
-    fputs(json_str, fp);
-    fclose(fp);
+    int ok = 1;
+    const char *p = json_str;
+    size_t left = strlen(json_str);
+    while (left > 0) {
+        ssize_t written = write(fd, p, left);
+        if (written < 0) {
+            if (errno == EINTR) continue;
+            log_error("Cannot save database: write '%s': %s", tmp_path, strerror(errno));
+            ok = 0;
+            break;
+        }
+        p += written;
+        left -= (size_t)written;
+    }
     json_object_put(root);
 
-    if (rename(tmp_path, path) != 0) {
+    if (ok && fsync(fd) != 0) {
+        log_error("Cannot save database: fsync '%s': %s", tmp_path, strerror(errno));
+        ok = 0;
+    }
+    if (close(fd) != 0 && ok) {
+        log_error("Cannot save database: close '%s': %s", tmp_path, strerror(errno));
+        ok = 0;
+    }
+    if (ok && rename(tmp_path, path) != 0) {
+        log_error("Cannot save database: rename to '%s': %s", path, strerror(errno));
+        ok = 0;
+    }
+    if (!ok) {
         unlink(tmp_path);
         return OWSYNC_ERROR_IO;
     }
 
+    fsync_parent_dir(path);
     return OWSYNC_OK;
 }
 
